# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
*.egg

# Virtualenvs
.venv/
venv/
env/
ENV/

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp
*.swo

# Engine / agent runtime artifacts (private to local runs)
.remoroo/

# Heavy workflow artifacts — regenerated by `python run.py`. Tracked
# `results.tsv`, `program.md` and small demo videos (≤ 3 MB) stay; large
# rendered videos, calibration artifacts and tensor caches are excluded.
artifacts/
renders/
video/

# Tensorboard / wandb runs
runs/
wandb/

# Backup files from previous runs
*.log.backup

# MuJoCo runtime artifacts
MUJOCO_LOG.TXT

# Note on checkpoints (`*.pt`): we don't ignore them globally — small
# baselines (≤ 5 MB) are useful evidence and stay tracked. If a workflow
# starts producing heavy checkpoints, add a per-workflow ignore.
