<!--
L2 calibration scene.

Design decisions:
  * ArUco marker is a PLANE, not a box, so the 2D texture maps onto it
    cleanly. The plane faces +x world after the euler rotation.
  * Sites have `group="3"` and the wrist-camera rendering ignores groups
    >= 2 so sites don't appear in captured images.
  * The gripper body itself, and the camera housing, use `group="2"` and
    are likewise hidden from the wrist camera. They remain visible in any
    external demo camera that the visualiser uses.
  * Camera is offset clear of the gripper geom so the camera never sees
    the inside of its own mount.

Units: metres, radians.
-->
<mujoco model="eye_in_hand_calib">
  <compiler angle="radian" autolimits="true"/>
  <option gravity="0 0 0" timestep="0.002"/>

  <visual>
    <global offwidth="1280" offheight="720"/>
    <quality shadowsize="4096"/>
    <rgba fog="0 0 0 0"/>
  </visual>

  <asset>
    <texture name="grid_tex" type="2d" builtin="checker" width="256" height="256"
             rgb1="0.22 0.22 0.24" rgb2="0.28 0.28 0.30"/>
    <material name="grid_mat" texture="grid_tex" texrepeat="6 6"
              specular="0.1" shininess="0.1"/>

    <texture name="aruco_tex" type="2d" file="assets/aruco_marker.png"/>
    <!-- emission=1 guarantees white cells render as full white regardless of
         lighting, which the ArUco detector needs for corner contrast. -->
    <material name="aruco_mat" texture="aruco_tex"
              specular="0" shininess="0" emission="1.0" rgba="1 1 1 1"/>

    <material name="gripper_mat" rgba="0.95 0.75 0.12 1" specular="0.2" shininess="0.3"/>
    <material name="camera_mat"  rgba="0.10 0.10 0.12 1" specular="0.3" shininess="0.4"/>
    <!-- True cube (what the robot should grasp) + ghost cube (where the agent
         THINKS the cube is after applying X_est to the marker detection).
         Both are group=2 so the locked wrist-camera sensor pipeline never
         sees them; they appear only in the observer-camera videos. -->
    <material name="cube_true_mat"  rgba="0.15 0.95 0.25 1"    emission="0.35" specular="0.2" shininess="0.2"/>
    <material name="cube_ghost_mat" rgba="0.98 0.12 0.18 0.55" emission="0.45" specular="0.0" shininess="0.0"/>
  </asset>

  <worldbody>
    <light name="sun"  pos="0 0 4"        dir="0 0 -1"      diffuse="0.8 0.8 0.8"/>
    <light name="fill" pos="1.5 -1.5 3"   dir="-0.5 0.5 -1" diffuse="0.4 0.4 0.4"/>
    <light name="rim"  pos="-0.5 2 2"     dir="0.2 -0.5 -1" diffuse="0.3 0.3 0.3"/>

    <geom name="ground" type="plane" size="3 3 0.1" material="grid_mat"/>

    <!-- ArUco marker: PLANE facing +x world, physical side 0.10 m.
         Plane normal is +z in local frame; `zaxis="1 0 0"` aligns that to
         world +x, so the textured face looks toward the gripper. -->
    <body name="aruco_body" pos="0.0 0.0 0.5" zaxis="1 0 0">
      <geom name="aruco_geom" type="plane" size="0.05 0.05 0.01"
            material="aruco_mat"/>
    </body>

    <!-- Observer cameras (debug-only; do NOT influence X_gt or sensor pipeline).
         Used by visualize_reach.py / render_reach_video.py to render iso /
         top-down / close-up shots of the scene for qualitative
         "is the arm actually reaching?" checks. -->
    <camera name="iso_cam" mode="fixed" pos="0.9 -0.9 0.9"
            xyaxes="0.707 0.707 0  -0.408 0.408 0.816" fovy="45"/>
    <camera name="top_cam" mode="fixed" pos="0.3 0.0 1.3"
            xyaxes="0 -1 0  1 0 0" fovy="55"/>
    <!-- Tighter iso-angle camera focused on the marker + reach zone. Used as
         the default camera for the auto-generated reach video. -->
    <camera name="reach_cam" mode="fixed" pos="0.55 -0.55 0.80"
            xyaxes="0.707 0.707 0  -0.408 0.408 0.816" fovy="50"/>

    <!-- Gripper: free-floating rigid body we teleport via qpos. Geoms are
         in group=2 so the wrist camera never sees them (sensor pipeline
         is untouched). Sized for clear visibility in the observer cams. -->
    <body name="gripper" pos="0.6 0.0 0.5">
      <freejoint name="gripper_free"/>
      <geom name="gripper_body" type="box" size="0.050 0.050 0.075"
            material="gripper_mat" group="2"/>
      <!-- Two small prongs to make the "gripper" recognisable as a hand
           in playback, rather than a floating box. -->
      <geom name="gripper_prong_l" type="box" size="0.010 0.010 0.035"
            pos="0.030 0.0 -0.110" material="gripper_mat" group="2"/>
      <geom name="gripper_prong_r" type="box" size="0.010 0.010 0.035"
            pos="-0.030 0.0 -0.110" material="gripper_mat" group="2"/>

      <!-- Camera mount: fixed offset from gripper = ground-truth X_gt.
           Placed clear of the gripper geom in the -z (away from arm) side
           of the gripper so the camera isn't looking at its own mount. -->
      <body name="camera_mount" pos="0.020 0.010 0.070" euler="0.00 0.15 0.08">
        <geom name="camera_body" type="box" size="0.018 0.018 0.026"
              material="camera_mat" group="2"/>
        <!-- Small red "lens" stub on +z face so the camera pointing
             direction is obvious in the video. -->
        <geom name="camera_lens" type="cylinder" size="0.012 0.008"
              pos="0 0 0.030" rgba="0.9 0.15 0.15 1" group="2"/>
        <camera name="wrist_cam" fovy="58" pos="0 0 0"/>
      </body>
    </body>

    <!-- Pick-task cubes (free-jointed so render_reach_video can teleport them
         analytically per run). SIBLINGS of gripper/aruco_body, so their pose
         cannot influence X_gt. group=2 hides them from wrist_cam, preserving
         the sensor pipeline. -->
    <!-- 2.5 cm cubes (half-extent 0.0125 m) -- picked so prong gap of 6 cm
         still straddles them cleanly with generous margin (cube/prong
         clearance = (60 - 25)/2 = 17.5 mm each side). -->
    <body name="target_cube" pos="0.15 0.10 0.50">
      <freejoint name="target_cube_free"/>
      <geom name="target_cube_geom" type="box" size="0.0125 0.0125 0.0125"
            material="cube_true_mat" group="2"/>
    </body>
    <body name="ghost_cube" pos="0.15 0.10 0.50">
      <freejoint name="ghost_cube_free"/>
      <geom name="ghost_cube_geom" type="box" size="0.0125 0.0125 0.0125"
            material="cube_ghost_mat" group="2"/>
    </body>
  </worldbody>
</mujoco>
